{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": ["*.ts", "*.tsx"],
  "exclude": ["*.test.ts", "*.test.tsx", "dist"]
}
